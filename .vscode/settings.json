{
  // lua_ls settings for this repo, which is opened at the dotfiles root rather
  // than at .config/nvim. The language server only reads .luarc.json from the
  // workspace root, so .config/nvim/.luarc.json alone does not reach it here
  // and every `vim.*` call is reported as an undefined global.
  //
  // Neovim sends the same settings itself, from
  // .config/nvim/lua/plugins/config/lsp.lua.
  //
  // Spell checking is configured in cspell.json at the repo root, not here, so
  // it applies to the cspell CLI too and not only to this editor.
  "Lua.runtime.version": "LuaJIT",
  "Lua.diagnostics.globals": ["vim"],
  "Lua.workspace.checkThirdParty": false,
  "Lua.telemetry.enable": false,

  // Neovim's type definitions are not reachable from here: they live under a
  // /nix/store path that changes on every upgrade, so there is nothing stable
  // to put in Lua.workspace.library. That makes `---@type vim.lsp.Config` and
  // friends in after/lsp/*.lua unresolvable names. lazydev supplies them
  // inside Neovim, which is where those annotations earn their keep.
  "Lua.diagnostics.disable": ["undefined-doc-name"]
}
