{
  // lua_ls settings for this repo, which is opened at the dotfiles root rather
  // than at .config/nvim. The language server only reads .luarc.json from the
  // workspace root, so .config/nvim/.luarc.json alone does not reach it here
  // and every `vim.*` call is reported as an undefined global.
  //
  // Neovim sends the same settings itself, from
  // .config/nvim/after/lsp/lua_ls.lua.
  //
  // Spell checking is configured in cspell.json at the repo root, not here, so
  // it applies to the cspell CLI too and not only to this editor.
  "Lua.runtime.version": "LuaJIT",
  "Lua.diagnostics.globals": ["vim"],
  "Lua.workspace.checkThirdParty": false,
  "Lua.telemetry.enable": false,

  // stylua owns Lua formatting here -- .stylua.toml, the pre-commit hook, and
  // conform's <leader>F inside Neovim. lua_ls cannot read .stylua.toml: it
  // formats with EmmyLuaCodeStyle, configured through .editorconfig, and its
  // defaults align consecutive table fields and call arguments. With the
  // global "editor.formatOnSave" on, that rewrote lua/plugins/init.lua on
  // every save into a style the pre-commit hook then reverted.
  //
  // Off rather than approximated in .editorconfig, because the two formatters
  // disagree in more places than the alignment. after/lsp/lua_ls.lua sets the
  // same thing for Neovim. The cost is that format-on-save does nothing for
  // Lua in VS Code; install JohnnyMorganz.stylua and point [lua] at it if that
  // is wanted back.
  "Lua.format.enable": false,

  // Neovim's type definitions are not reachable from here: they live under a
  // /nix/store path that changes on every upgrade, so there is nothing stable
  // to put in Lua.workspace.library. That makes `---@type vim.lsp.Config` and
  // friends in after/lsp/*.lua unresolvable names. lazydev supplies them
  // inside Neovim, which is where those annotations earn their keep.
  "Lua.diagnostics.disable": ["undefined-doc-name"],

  // Format Lua on save with the same stylua the pre-commit hook and conform
  // use, now that lua_ls's own formatter is off above. The extension reads
  // .stylua.toml from the workspace root directly, so the three consumers
  // cannot drift the way lua_ls did.
  //
  // searchBinaryInPATH rather than a styluaPath: left alone the extension
  // downloads its own binary from GitHub releases, which would be a different
  // version from the nix-managed 2.5.2, and hardcoding
  // /run/current-system/sw/bin/stylua would only be right on the nix-darwin
  // hosts -- this repo is checked out on Arch and WSL too. If VS Code is
  // launched from Finder and does not inherit the shell PATH, set
  // stylua.styluaPath on that machine instead.
  //
  // disableVersionCheck stops it phoning GitHub about releases that nix
  // controls, not the extension.
  "[lua]": {
    "editor.defaultFormatter": "JohnnyMorganz.stylua"
  },
  "stylua.searchBinaryInPATH": true,
  "stylua.disableVersionCheck": true
}
