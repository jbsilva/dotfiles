# Show/hide all files in Finder
alias showAllOn='defaults write com.apple.finder AppleShowAllFiles 1 && killall Finder'
alias showAllOff='defaults write com.apple.finder AppleShowAllFiles 0 && killall Finder'

# Show/hide desktop
alias hide_Desktop='defaults write com.apple.finder CreateDesktop -bool FALSE; killall Finder'
alias show_Desktop='defaults write com.apple.finder CreateDesktop TRUE; killall Finder'

# Mosh to a host whose mosh-server comes from a Nix profile: `mosh-nix nas`.
#
# mosh starts the server as a plain command over SSH, so it has to find
# mosh-server on the remote $PATH. That command runs in a shell that is neither
# interactive nor a login shell, and on DSM such a shell gets
# /usr/bin:/bin:/usr/sbin:/sbin and nothing else. The Nix profile is not on it,
# so the default lookup fails with "Did not find mosh server startup message".
#
# The inner quotes are what keeps the tilde intact past this shell. mosh
# interpolates --server into the remote command line unquoted, so the NAS
# expands it against its own $HOME.
alias mosh-nix="mosh --server='~/.nix-profile/bin/mosh-server'"

# SSH to the NAS, telling the session that starts there that it is nested.
#
# Zellij 0.45.0 handles a session inside a pane properly, but only once the
# inner one knows it is nested, and it decides that by looking for $ZELLIJ in
# its own environment. Nothing forwards it: DSM's sshd sets no AcceptEnv, so
# the marker rides in the remote command, and the shared .zshrc turns it back
# into $ZELLIJ before it starts zellij. Without this the NAS draws its own
# status bar under the one already on screen.
#
# Only from inside a pane, and only with no command of your own: `nas uptime`
# still runs uptime rather than a login shell.
nas() {
  if [[ -n "$ZELLIJ" && $# -eq 0 ]]; then
    ssh -t nas 'DOTFILES_ZELLIJ_HOST=1 $SHELL -l'
  else
    ssh nas "$@"
  fi
}

