# Synology DSM only (RS2423+, DSM 7.x)
#
# Sourced from .zshrc when /etc/synoinfo.conf exists. Loaded *before*
# zshrc_linux, which also runs on this box.
#
# Packages come from two places:
#   Entware        opkg, installs under /opt          -- CLI tools
#   SynoCommunity  packages.synocommunity.com          -- DSM packages
#
# DSM resets a lot on upgrade. Anything here must degrade gracefully: check for
# the binary before using it, never assume a path exists.
if [[ ! -f /etc/synoinfo.conf ]]; then
  return 1
fi

###############################################################################
# Entware
#
# Entware lives entirely under /opt and is not on DSM's default PATH. Put it
# first so its coreutils/zsh/git win over DSM's older busybox-ish versions.
###############################################################################
if [[ -d /opt/bin ]]; then
  addToPathStart /opt/sbin
  addToPathStart /opt/bin

  # Entware's terminfo goes on $TERMINFO_DIRS in .zshenv, not here: ncurses
  # fixes the search path before .zshrc runs.
fi

###############################################################################
# SynoCommunity
#
# Packages install under /var/packages/<name>/target and are symlinked into
# /usr/local/bin. /etc/profile puts that on $PATH, but only for login shells, so
# an interactive non-login zsh gets neither and loses the ~250 tools the
# synocli-* bundles put there: bat, fzf, fd, eza, rg, less, ncdu, btop, tmux,
# mtr, nmap.
#
# addToPathEnd, not Start: `typeset -U path` keeps the first copy of a
# duplicate, so in a login shell this is a no-op and /etc/profile's ordering
# stands. Prepending would shadow DSM's own ssh, scp, sftp, sshd, perl and
# rsync with the synocli builds of the same name.
###############################################################################
[[ -d /usr/local/bin ]] && addToPathEnd /usr/local/bin

###############################################################################
# Nix
#
# Single-user install, because DSM has no systemd to run the daemon. The store
# is a bind mount from a volume, re-established by a Boot-up task, so guard on
# the profile script: between a reboot and that task, ~/.nix-profile dangles.
#
# Sourced here rather than in .zshenv, where the installer put it, so that the
# $HOME/bin re-prepend at the end of .zshrc still outranks the Nix profile. It
# does land ahead of Entware, which is the order we want.
###############################################################################
[[ -r $HOME/.nix-profile/etc/profile.d/nix.sh ]] &&
  source "$HOME/.nix-profile/etc/profile.d/nix.sh"

###############################################################################
# DSM specifics
###############################################################################

# DSM has no /etc/localtime-driven TZ for non-login shells.
[[ -z $TZ && -r /etc/TZ ]] && export TZ="$(< /etc/TZ)"

# Volumes. Adjust to match the actual volume layout.
export SYNO_VOLUME="${SYNO_VOLUME:-/volume1}"

###############################################################################
# Aliases
###############################################################################

# Package management
if (( $+commands[opkg] )); then
  alias opkgu='opkg update'
  alias opkgi='opkg install'
  alias opkgl='opkg list-installed'
fi

# DSM service control
alias syno-services='sudo synosystemctl get-active-list'
alias syno-restart='sudo synosystemctl restart'
alias syno-status='sudo synosystemctl get-active-status'

# Storage
alias syno-raid='cat /proc/mdstat'
alias syno-smart='sudo smartctl -a'
alias syno-temp='sudo synonvme --get-location 2>/dev/null; sudo hdparm -H /dev/sata1 2>/dev/null'

# Most of what runs here is dockerized. DSM calls it "Container Manager" but the
# CLI is still docker.
if (( $+commands[docker] )); then
  # DSM keeps /var/run/docker.sock root-only, and its docker group is
  # root-equivalent, so joining it to avoid sudo gives away more than it saves.
  # Route the calls through sudo instead. zsh re-expands the first word of an
  # alias body, so dps and the dc* aliases in .zshrc go through this as well.
  alias docker='sudo docker'

  # dps/dc* are defined in .zshrc for every platform. Only the DSM-specific
  # extras belong here.
  #
  # dpst: the columns that matter when checking on a NAS at a glance.
  alias dpst='docker ps --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}"'
  # Compose stacks from DSM's UI. The volume is fixed when Container Manager is
  # installed (volume3 here), so find it rather than name it.
  function cdstacks() {
    local d
    for d in /volume*/docker(N/); do
      cd "$d"
      return
    done
    print -u2 "cdstacks: no /volume*/docker directory on this host"
    return 1
  }
fi

###############################################################################
# Notes
#
# Nix on DSM: possible but awkward. There is no systemd, so the multi-user
# daemon install does not apply, and /nix must live on a volume that survives
# DSM upgrades (e.g. /volume1/nix bind-mounted to /nix from a boot-up task).
# A single-user install works:
#   sh <(curl -L https://nixos.org/nix/install) --no-daemon
# Given most workloads here are containers, Entware plus a toolbox container is
# usually less maintenance.
###############################################################################
