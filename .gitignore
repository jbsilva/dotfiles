# =============================================================================
# .gitignore
#
# IMPORTANT: ~/.config is a symlink to this repo's .config/ directory, so every
# application on this machine writes its runtime state *inside the repo*. A
# deny-list is unsafe here: any newly installed app silently drops files (often
# containing tokens, cookies or session state) into a tracked directory, and one
# `git add -A` publishes them.
#
# Therefore .config/ uses an ALLOW-LIST: everything is ignored, git is allowed
# to descend into directories, and only explicitly listed files are trackable.
#
# To track a new config file:
#   1. add a `!/.config/path/to/file` line in the allow-list below
#   2. `git add .config/path/to/file`
# `git check-ignore -v <path>` explains why any path is ignored.
# =============================================================================

# -----------------------------------------------------------------------------
# .config — deny everything
# -----------------------------------------------------------------------------
/.config/**

# Let git descend into directories so the allow-list below can match.
!/.config/**/

# -----------------------------------------------------------------------------
# .config — allow-list
# -----------------------------------------------------------------------------

# VS Code
!/.config/Code/User/keybindings.json
!/.config/Code/User/settings.json

# Editors
!/.config/nvim/**/*.lua
# lazy.nvim writes its plugin lockfile into the config dir; it pins versions
# and belongs in git.
!/.config/nvim/lazy-lock.json

# Terminal / multiplexer
!/.config/tmux/tmux.conf
!/.config/tmux/tmux.conf.local

# Tooling
!/.config/gh/config.yml
!/.config/gh/hosts.yml
!/.config/homebrew/trust.json
!/.config/pypoetry/config.toml

# -----------------------------------------------------------------------------
# .config — re-ignore heavy runtime dirs
#
# These hold VM images and caches (Colima alone is ~18 GB). Listing them after
# the allow-list stops git from traversing them on every `status`.
# -----------------------------------------------------------------------------
/.config/colima/
/.config/raycast/
/.config/opencode/
/.config/Transmission Remote GUI/
/.config/nvim/spell/
/.config/nvim/.netrwhist
/.config/photo-tagger/logs/

# =============================================================================
# Everything outside .config
# =============================================================================

# Build artifacts / nix
result
result-*
/nix-darwin/result
/nix-darwin/result-*

# Editor & OS noise
*.pyc
__pycache__/
.DS_Store
*.swp
*.swo
*~

# Secrets / local overrides (never commit)
*.env
.env
.env.*
!.env.example
*.pem
*.key
!*.pub
id_rsa*
id_ed25519*
*.kdbx
.netrc
.authinfo*

# AI tooling
/.github/instructions/codacy.instructions.md
