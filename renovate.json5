// Renovate configuration: automated dependency updates for the GitHub Actions SHA pins in
// .github/workflows/ and the hook revs in prek.toml.
//
// Setup: install the Renovate GitHub App (https://github.com/apps/renovate) and merge the one-time
// "Configure Renovate" onboarding PR. Renovate's GitHub-sourced security PRs need the repo's
// Dependency graph + Dependabot alerts enabled (Settings -> Security).
//
// Validate after editing: `just lint` runs renovate-config-validator as a hook.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // config:best-practices keeps GitHub Actions pinned to a full commit SHA with the version in the
  // trailing comment, which is the form zizmor requires and the workflows already use. It also
  // enables the Dependency Dashboard issue. The built-in pre-commit manager stays off: it reads only
  // .pre-commit-config.ya?ml, and prek reads prek.toml here. A regex manager below covers the hook
  // revs instead, which is the reason this repo wants Renovate rather than Dependabot: Dependabot
  // has no custom managers.
  extends: ["config:best-practices"],

  timezone: "Europe/Berlin",

  // Cron (the minute field must be "*"): a Monday 02:00-06:59 window, ahead of the 06:00 Monday
  // cron in ci.yml so a bump and the weekly drift check do not land on top of each other. The
  // window only *allows* PRs to open; the hosted App decides when it actually runs.
  schedule: ["* 2-6 * * 1"],

  // Hold a non-security release for 3 days before opening a PR. A compromised action or hook is
  // usually caught and yanked within days, and nothing in a dotfiles repo needs the newest possible
  // pin. `renovate-check` in .zsh/renovate_check.zsh reports what this is currently holding back.
  minimumReleaseAge: "3 days",

  // Security fixes open immediately, bypassing the weekly window and the hold above.
  vulnerabilityAlerts: {
    labels: ["dependencies", "security"],
    minimumReleaseAge: "0 days",
  },

  labels: ["dependencies"],

  // Match the commit style in AGENTS.md: "area: imperative summary".
  commitMessagePrefix: "ci:",
  semanticCommits: "disabled",

  packageRules: [
    // --- Batch the routine bumps, let majors land alone for their own review. ---
    {
      description: "GitHub Actions: group minor+patch",
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      groupName: "github-actions (minor+patch)",
    },
    {
      description: "prek hooks: group minor+patch",
      // github-tags keeps the zizmor wheel pins (pypi, same manager type) out of this group.
      matchManagers: ["custom.regex"],
      matchDatasources: ["github-tags"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "prek hooks (minor+patch)",
    },

    // --- Cross-file version sync. Several tools are pinned twice: once as a prek hook rev,
    //     once as a nixpkgs package that the `local` hooks and CI call off $PATH. Renovate only
    //     manages the hook side (nixpkgs versions move with flake.lock), but grouping keeps each
    //     tool's PR self-contained and named after the tool, so it is obvious when a hook has moved
    //     ahead of the binary `just lint` actually runs. ---
    {
      description: "typos: hook rev, twinned with the typos package in packages.nix",
      matchPackageNames: ["crate-ci/typos"],
      groupName: "typos",
    },
    {
      description: "zizmor: the wheel is pinned in both prek.toml and ci.yml",
      matchPackageNames: ["zizmor"],
      groupName: "zizmor",
    },
    {
      description: "actionlint: hook rev, twinned with the actionlint package in packages.nix",
      matchPackageNames: ["rhysd/actionlint"],
      groupName: "actionlint",
    },
  ],

  customManagers: [
    // Renovate has no native prek manager yet (renovatebot/renovate#41683), so this reads the
    // repo/rev pairs out of prek.toml. It emits the same owner/repo slugs the pre-commit manager
    // does, which the packageRules above match on. Drop it once a native manager ships.
    {
      customType: "regex",
      description: "prek hook revs in prek.toml",
      managerFilePatterns: ["/(^|/)prek\\.toml$/"],
      // "[^\\[]*?" tolerates comments or blank lines between the two keys but never crosses into
      // the next "[[repos]]" table, so a rev is never paired with the wrong repo. The builtin and
      // local repos have no rev and never match.
      matchStrings: [
        "repo\\s*=\\s*[\"']https://github\\.com/(?<packageName>[^\"'\\s]+?)(?:\\.git)?[\"'][^\\[]*?rev\\s*=\\s*[\"'](?<currentValue>[^\"']+)[\"']",
      ],
      datasourceTemplate: "github-tags",
    },

    // The hook rev regex above reads `rev`, not `additional_dependencies`, and nothing parses a
    // `run:` line, so the zizmor pins need their own. The shared depName groups all of them into the
    // one PR above. On a prerelease pin, `ignoreUnstable` follows later prereleases of that same
    // version and then its stable release, and never jumps to the next prerelease train.
    {
      customType: "regex",
      managerFilePatterns: [
        "prek.toml",
        ".github/workflows/ci.yml",
      ],
      matchStrings: ["zizmor==(?<currentValue>[0-9][^\"'\\s]*)"],
      datasourceTemplate: "pypi",
      depNameTemplate: "zizmor",
      versioningTemplate: "pep440",
    },
  ],

  // The Nix manager is deliberately off. flake.lock is updated on purpose with `just update` (or
  // `just update-input <name>`) and reviewed with `just diff` before a switch, and nixpkgs tracks
  // nixpkgs-unstable, which moves several times a day -- Renovate would open a PR against it
  // continuously. The Monday cron in ci.yml is what catches drift from upstream here.
  //
  // Not managed by anything, for the record: .config/nvim/lazy-lock.json is written by `:Lazy`
  // commands (see AGENTS.md).
  //
  // Anything pinned as a `fetchFromGitHub` rev plus hash would join it, because Renovate cannot
  // compute a fixed-output hash. That is the reason git-extra-commands is a flake input rather than
  // a rev in modules/git-extra-commands.nix: `just update` reaches it there.
  enabledManagers: ["github-actions", "custom.regex"],
}
