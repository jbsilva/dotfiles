[core]
	excludesfile = ~/.gitignore-global
	autocrlf = false
	safecrlf = warn
	editor = nvim
	# fsmonitor = true
	# untrackedCache = true
[pull]
	rebase = true
[init]
	defaultBranch = main
[column]
	ui = auto
[branch]
	sort = -committerdate
[commit]
	gpgsign = true
	verbose = true
[tag]
	sort = version:refname
	gpgSign = true
[merge]
	# nvim rather than meld: meld is not installed on any of these machines,
	# and nvim is already core.editor everywhere.
	tool = nvimdiff
	conflictstyle = zdiff3
[diff]
	guitool = nvimdiff
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true
	renames = true
[push]
	autoSetupRemote = true
	default = simple
	followTags = true
[fetch]
	prune = true
	pruneTags = true
	all = true
[help]
	autocorrect = prompt
[rerere]
	enabled = true
	autoupdate = true
[rebase]
	autoSquash = true
	autoStash = true
	updateRefs = true
# The alias list is shared with git.nix, so the MacBook and the Synology get the
# same one. It used to be duplicated here and drifted. See git/aliases.
#
# Absolute, not relative: this file is reached as ~/.gitconfig-global, a symlink
# into the repo, and git resolves a relative include against the directory it
# found the file in, which is $HOME.
[include]
	path = ~/dotfiles/git/aliases

[includeIf "gitdir:~/Dev/Hoppe/**"]
	path = ~/Dev/Hoppe/.gitconfig
